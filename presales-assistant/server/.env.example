# --- Supabase (Settings > API in your Supabase project) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- GitHub (fine-grained PAT, Contents:read on salil-dengage/lead-gen) ---
GITHUB_TOKEN=ghp_...
GITHUB_REPO=salil-dengage/lead-gen
KB_KNOWLEDGE_BASE_PATH=dengage-presales-claude-code/knowledge-base
KB_INFOSEC_PATH=dengage-presales-claude-code/infosec

# --- Optional web search for external proof points ---
SERPER_API_KEY=

# --- Admin access (comma-separated emails), gates /api/ingest and the
#     down-voted-feedback report ---
ADMIN_EMAILS=rfp@dengage.com

# --- Server ---
PORT=8080
